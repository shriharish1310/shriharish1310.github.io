# Netlify / Cloudflare Pages (not used by GitHub Pages). Rename or copy rules in your CDN dashboard if needed.

/styles.min.css
  Cache-Control: public, max-age=31536000, immutable

/main.min.js
  Cache-Control: public, max-age=31536000, immutable

/profile.webp
  Cache-Control: public, max-age=31536000, immutable

/profile.avif
  Cache-Control: public, max-age=31536000, immutable

/profile.jpg
  Cache-Control: public, max-age=604800

/resume.pdf
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=3600, must-revalidate

/index.html
  Cache-Control: public, max-age=3600, must-revalidate
